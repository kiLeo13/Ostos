OSTOS_ENV=production
OSTOS_HTTP_ADDRESS=:8443
OSTOS_DATABASE_DSN={{ vault_ostos_database_dsn }}
OSTOS_SNOWFLAKE_NODE_ID={{ snowflake_node_id }}
OSTOS_JWT_SECRET_BASE64={{ vault_ostos_jwt_secret_base64 }}
OSTOS_EMAIL_TOKEN_KEY_BASE64={{ vault_ostos_email_token_key_base64 }}
OSTOS_JWT_ISSUER=ostos
OSTOS_JWT_AUDIENCE=ostos-clients
OSTOS_PUBLIC_APP_URL={{ ostos_public_app_url }}
OSTOS_CORS_ORIGINS={{ ostos_cors_origins | join(',') }}
OSTOS_TRUSTED_PROXY_CIDRS={{ cloudflare_ipv4_cidrs | join(',') }}
OSTOS_TLS_CERT_FILE=/run/secrets/ostos/origin.crt
OSTOS_TLS_KEY_FILE=/run/secrets/ostos/origin.key
OSTOS_API_HOSTNAME={{ ostos_api_hostname }}
OSTOS_SES_ENABLED={{ ostos_ses_enabled | lower }}
OSTOS_SES_REGION={{ ostos_ses_region }}
OSTOS_SES_FROM={{ ostos_ses_from }}
AWS_ACCESS_KEY_ID={{ vault_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ vault_aws_secret_access_key }}

